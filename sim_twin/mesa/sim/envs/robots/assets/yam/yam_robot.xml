<?xml version="1.0" ?>
<!-- YAM (Yet Another Manipulator) 6-DOF arm adapted for robosuite.
     Original: https://github.com/google-deepmind/mujoco_menagerie/tree/main/i2rt_yam
     Changes from original yam.xml:
       - Converted position actuators to motor (torque) actuators for OSC compatibility
       - Removed integrated gripper (fingers, finger actuator, equality constraint)
       - Added robosuite-compatible body hierarchy (base -> arm -> ... -> right_hand)
       - Added right_center site, robotview camera, eye_in_hand camera
       - Removed gravcomp (OSC controller handles gravity compensation)
       - Removed <option>, <keyframe>, spotlight light
-->
<mujoco model="yam">
  <compiler angle="radian" meshdir="meshes"/>

  <actuator>
    <!-- Torque-controlled motors matching the YAM's force limits -->
    <motor ctrllimited="true" ctrlrange="-28.0 28.0" joint="joint1" name="torq_j1"/>
    <motor ctrllimited="true" ctrlrange="-28.0 28.0" joint="joint2" name="torq_j2"/>
    <motor ctrllimited="true" ctrlrange="-28.0 28.0" joint="joint3" name="torq_j3"/>
    <motor ctrllimited="true" ctrlrange="-10.0 10.0" joint="joint4" name="torq_j4"/>
    <motor ctrllimited="true" ctrlrange="-10.0 10.0" joint="joint5" name="torq_j5"/>
    <motor ctrllimited="true" ctrlrange="-10.0 10.0" joint="joint6" name="torq_j6"/>
  </actuator>

  <asset>
    <material name="yam_black" rgba="0.25 0.25 0.25 1"/>
    <material name="yam_white" rgba="0.9 0.9 0.9 1"/>

    <mesh name="yam_base" file="meshes/model2.stl"/>
    <mesh name="yam_link1" file="meshes/model2__2.stl"/>
    <mesh name="yam_link2_a" file="meshes/model2__3.stl"/>
    <mesh name="yam_link2_b" file="meshes/model2__4.stl"/>
    <mesh name="yam_link2_c" file="meshes/model2__5.stl"/>
    <mesh name="yam_link3_a" file="meshes/model2__6.stl"/>
    <mesh name="yam_link3_b" file="meshes/model2__7.stl"/>
    <mesh name="yam_link3_c" file="meshes/model2__8.stl"/>
    <mesh name="yam_link3_d" file="meshes/model2__9.stl"/>
    <mesh name="yam_link4" file="meshes/model2__10.stl"/>
    <mesh name="yam_link5" file="meshes/model2__11.stl"/>
    <mesh name="yam_link6_a" file="meshes/model2__12.stl"/>
    <mesh name="yam_link6_b" file="meshes/model2__13.stl"/>
  </asset>

  <worldbody>
    <body name="base" pos="0 0 0">
      <!-- robot view -->
      <camera mode="fixed" name="robotview" pos="1.0 0 0.4" quat="0.653 0.271 0.271 0.653"/>
      <inertial diaginertia="0 0 0" mass="0" pos="0 0 0"/>
      <!-- mount attached here -->
      <body name="arm" pos="0 0 0">
        <site name="right_center" pos="0 0 0" size="0.01" rgba="1 0.3 0.3 1" group="2"/>
        <inertial pos="0 0 0.03" mass="1.0" diaginertia="0.01 0.01 0.01"/>
        <!-- base visual -->
        <geom type="mesh" mesh="yam_base" pos="0 0 -0.0006" quat="1 0 0 1"
              material="yam_black" contype="0" conaffinity="0" group="1"/>
        <!-- base collision -->
        <geom type="capsule" size="0.033 0.01" pos="0.0 0.0 0.026" group="0"/>

        <body name="link_1" pos="0 0 0.0631" quat="1 0 0 1">
          <inertial pos="-0.00192861 -0.00795735 0.0208176"
                    quat="0.297851 0.642634 0.360045 0.607185" mass="0.12415"
                    diaginertia="0.000180751 0.000145532 5.89179e-05"/>
          <joint name="joint1" pos="0 0 0" axis="0 0 1" limited="true"
                 range="-2.61799 3.05433" armature="0.032" frictionloss="0.1"/>
          <!-- link_1 visual -->
          <geom type="mesh" mesh="yam_link1" pos="5.26159e-07 2.34355e-07 -0.0632"
                material="yam_black" contype="0" conaffinity="0" group="1"/>
          <!-- link_1 collision -->
          <geom type="mesh" mesh="yam_link1" group="0" name="link1_collision"/>

          <body name="link_2" pos="2.5e-05 -0.02 0.0409" quat="1 1 1 1">
            <inertial pos="0.132008 2.10599e-06 0.000293073" quat="1 1 1 1" mass="1.24434"
                      diaginertia="0.0121902 0.0121318 0.000683304"/>
            <joint name="joint2" pos="0 0 0" axis="0 0 1" limited="true"
                   range="0 3.66519" armature="0.032" frictionloss="0.1"/>
            <!-- link_2 visuals -->
            <geom type="mesh" mesh="yam_link2_a" pos="0.0199992 -0.1041 -2.44738e-05" quat="1 -1 -1 -1"
                  material="yam_black" contype="0" conaffinity="0" group="1"/>
            <geom type="mesh" mesh="yam_link2_b" pos="0.0199992 -0.1041 -2.44738e-05" quat="1 -1 -1 -1"
                  material="yam_black" contype="0" conaffinity="0" group="1"/>
            <geom type="mesh" mesh="yam_link2_c" pos="0.0199992 -0.1041 -2.44738e-05" quat="1 -1 -1 -1"
                  material="yam_white" contype="0" conaffinity="0" group="1"/>
            <!-- link_2 collisions -->
            <geom type="capsule" size="0.032 0.11" pos="0.13 0 0" quat="1 0 1 0" group="0" name="link2_collision_a"/>
            <geom type="capsule" size="0.033 0.02" pos="0 0.0 0" group="0" name="link2_collision_b"/>
            <geom type="capsule" size="0.033 0.025" pos="0.265 0 0" group="0" name="link2_collision_c"/>

            <body name="link_3" pos="0.264 0 0" quat="0 1 0 0">
              <inertial pos="-0.121816 -0.054846 -0.000111108" quat="1 1 1 1" mass="0.853698"
                        diaginertia="0.00699732 0.00696112 0.000788244"/>
              <joint name="joint3" pos="0 0 0" axis="0 0 1" limited="true"
                     range="0 3.66519" armature="0.032" frictionloss="0.1"/>
              <!-- link_3 visuals -->
              <geom type="mesh" mesh="yam_link3_a" pos="-0.244001 0.104101 2.44738e-05" quat="1 1 1 -1"
                    material="yam_black" contype="0" conaffinity="0" group="1"/>
              <geom type="mesh" mesh="yam_link3_b" pos="-0.244001 0.104101 2.44738e-05" quat="1 1 1 -1"
                    material="yam_black" contype="0" conaffinity="0" group="1"/>
              <geom type="mesh" mesh="yam_link3_c" pos="-0.244001 0.104101 2.44738e-05" quat="1 1 1 -1"
                    material="yam_white" contype="0" conaffinity="0" group="1"/>
              <geom type="mesh" mesh="yam_link3_d" pos="-0.244001 0.104101 2.44738e-05" quat="1 1 1 -1"
                    material="yam_black" contype="0" conaffinity="0" group="1"/>
              <!-- link_3 collisions -->
              <geom type="capsule" size="0.034 0.12" pos="-0.14 -0.06 0.0" quat="1 0 1 0" group="0" name="link3_collision_a"/>
              <geom type="capsule" size="0.034 0.015" pos="-0.24 -0.06 0.0" group="0" name="link3_collision_b"/>

              <body name="link_4" pos="-0.245 -0.06 0" quat="1 0 0 0">
                <inertial pos="-0.0769778 -0.0527104 0.000154878"
                          quat="0.667 0.667 -0.236 -0.236" mass="0.463511"
                          diaginertia="0.000791532 0.000744733 0.000282116"/>
                <joint name="joint4" pos="0 0 0" axis="0 0 1" limited="true"
                       range="-1.5708 1.5708" armature="0.0018" frictionloss="0.1"/>
                <!-- link_4 visual -->
                <geom type="mesh" mesh="yam_link4" pos="0.00100023 0.164101 2.44738e-05" quat="1 1 1 -1"
                      material="yam_black" contype="0" conaffinity="0" group="1"/>
                <!-- link_4 collision -->
                <geom type="capsule" size="0.03 0.015" pos="-0.073 -0.06 0.0" quat="1 1 0 0" group="0" name="link4_collision"/>

                <body name="link_5" pos="-0.074 -0.0395 2.5e-05" quat="1 -1 1 1">
                  <inertial pos="3.64861e-05 0.00025665 0.0353526" mass="0.350962"
                            diaginertia="0.000197802 0.0001775 0.000147402"/>
                  <joint name="joint5" pos="0 0 0" axis="0 0 1" limited="true"
                         range="-1.5708 1.5708" armature="0.0018" frictionloss="0.1"/>
                  <!-- link_5 visual -->
                  <geom type="mesh" mesh="yam_link5" pos="0 -0.0749971 0.203601" quat="1.32679e-06 1 0 0"
                        material="yam_black" contype="0" conaffinity="0" group="1"/>
                  <!-- link_5 collision -->
                  <geom type="capsule" size="0.030 0.015" pos="0 0.025 0.0395" quat="1 1 0 0" group="0" name="link5_collision"/>

                  <body name="link_6" pos="0 0.0353 0.0395" quat="1 -1 0 0">
                    <inertial pos="-0.000217767 7.37059e-05 0.0270545" quat="1 1 0 0" mass="0.367476"
                              diaginertia="0.000265958 0.000242686 0.000227409"/>
                    <joint name="joint6" pos="0 0 0" axis="0 0 1" limited="true"
                           range="-2.0944 2.0944" armature="0.0018" frictionloss="0.1"/>
                    <!-- link_6 visuals -->
                    <geom type="mesh" mesh="yam_link6_a" pos="0 -0.164101 -0.110597" quat="1 -1 0 0"
                          material="yam_black" contype="0" conaffinity="0" group="1"/>
                    <geom type="mesh" mesh="yam_link6_b" pos="0 -0.164101 -0.110597" quat="1 -1 0 0"
                          material="yam_black" contype="0" conaffinity="0" group="1"/>
                    <!-- link_6 collisions -->
                    <geom type="capsule" size="0.030 0.005" pos="0 0.0 0.03" quat="1 0 0 1" group="0" name="link6_collision"/>

                    <!-- right_hand: gripper attachment point (robosuite convention) -->
                    <body name="right_hand" pos="0 0 0.06" quat="1 0 0 0">
                      <inertial pos="0 0 0" mass="0.01" diaginertia="0.001 0.001 0.001"/>
                      <camera
                        mode="fixed"
                        name="eye_in_hand"
                        pos="0 0.105 0.015"
                        quat="0 0 0.929844 0.367955"
                        fovy="80.0"
                      />
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
